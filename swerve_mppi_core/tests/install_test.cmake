function(run)
 execute_process(COMMAND ${ARGV} RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "Installed consumer failed: ${ARGV}")
 endif()
endfunction()
file(REMOVE_RECURSE "${BUILD_DIR}/consumer-check")
run("${CMAKE_COMMAND}" --install "${BUILD_DIR}" --prefix "${BUILD_DIR}/consumer-check/install")
file(RENAME "${BUILD_DIR}/consumer-check/install" "${BUILD_DIR}/consumer-check/relocated")
run("${CMAKE_COMMAND}" -S "${SOURCE_DIR}/tests/consumer" -B "${BUILD_DIR}/consumer-check/build" "-DCMAKE_PREFIX_PATH=${BUILD_DIR}/consumer-check/relocated")
run("${CMAKE_COMMAND}" --build "${BUILD_DIR}/consumer-check/build" --parallel 2)
run("${CMAKE_CTEST_COMMAND}" --test-dir "${BUILD_DIR}/consumer-check/build" --output-on-failure)
